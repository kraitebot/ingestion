{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "kraitebot/ingestion",
    "type": "project",
    "description": "Kraite Ingestion",
    "keywords": [
        "crypto",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4.0",
        "brunocfalcao/blade-feather-icons": "^6.0",
        "brunocfalcao/laravel-helpers": "^1.0",
        "brunocfalcao/step-dispatcher": "^1.12",
        "kraitebot/core": "^1.36",
        "laravel-notification-channels/telegram": "^7.0",
        "laravel/framework": "^13.23.0",
        "laravel/horizon": "^5.46",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.32",
        "nunomaduro/essentials": "^1.0.1",
        "resend/resend-php": "^1.3",
        "spatie/laravel-backup": "^10.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/kraitebot/core.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/brunocfalcao/step-dispatcher.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/brunocfalcao/blade-feather-icons.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/brunocfalcao/laravel-helpers.git"
        }
    ]
}
